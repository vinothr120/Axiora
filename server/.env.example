# Copy to .env for local development.

PORT=4000
NODE_ENV=development

# sqlite (default, no server needed) for local dev; mysql for cPanel deployment.
DB_DRIVER=sqlite

# Only used when DB_DRIVER=mysql (cPanel MySQL Databases credentials).
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=

# Creates the first admin account on first boot if no admins exist yet.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-now

# Client session idle timeout (minutes) — also applied to admin sessions.
SESSION_IDLE_MINUTES=30
